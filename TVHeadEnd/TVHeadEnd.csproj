<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TVHeadEnd</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\tvheadend.html" />
    <None Remove="Web\tvheadend.js" />
    <EmbeddedResource Include="Web\tvheadend.html" />
    <EmbeddedResource Include="Web\tvheadend.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pinned, not a range, and pinned to what the plugin is actually run against rather than to
      whatever a floating range resolves to. The running server identifies itself only as 12.0.0.0
      in its own assemblies and deps file, with no prerelease label surviving there, so this version
      is justified by the plugin building, testing and working against that server, not by a
      version string matching. This plugin leans on a handful of specific Jellyfin behaviours: the
      ILiveStream contract, IMediaSourceManager.GetLiveStreamInfo and the LiveStreamId that
      addresses it, the allowVideoStreamCopy request parameter that EncodingHelper reads, the way
      LiveTvMediaSourceProvider normalises a live source, and ProgressiveFileStream's polling of a
      stream that returns nothing. A floating range would quietly build against a different
      set of them on any restore. This is the version the branch is developed and run against.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc5" />

    <!--
      Compiled against, never shipped. Jellyfin already loads SkiaSharp for its own image
      processing, and it sits beside the server assemblies with native libraries for every runtime
      that Jellyfin supports. ExcludeAssets="runtime" lets this use the copy that is already there.
      Shipping a second one would mean carrying native binaries for every architecture in the
      plugin zip, and risking two versions of the same native library in one process.
    -->

    <PackageReference Include="SkiaSharp" Version="3.119.4" ExcludeAssets="runtime" />

  </ItemGroup>

  <!--
    Both references point inwards and neither points back. The core knows what a broadcast, a
    recording and a transport stream are; the protocol client knows how to talk to TVHeadend;
    this project is the only one that knows Jellyfin exists, and it is where the two are joined.
  -->
  <ItemGroup>
    <ProjectReference Include="..\TVHeadEnd.Core\TVHeadEnd.Core.csproj" />
    <ProjectReference Include="..\Tvheadend.Htsp\Tvheadend.Htsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

</Project>
