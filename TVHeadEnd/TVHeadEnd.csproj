<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TVHeadEnd</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\tvheadend.html" />
    <None Remove="Web\tvheadend.js" />
    <EmbeddedResource Include="Web\tvheadend.html" />
    <EmbeddedResource Include="Web\tvheadend.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pinned, not a range. This plugin leans on a handful of specific Jellyfin behaviours: the
      ILiveStream contract, IMediaSourceManager.GetLiveStreamInfo and the LiveStreamId that
      addresses it, the allowVideoStreamCopy request parameter that EncodingHelper reads, the way
      LiveTvMediaSourceProvider normalises a live source, and ProgressiveFileStream's polling of a
      stream that returns nothing. A floating range would quietly build against a different
      set of them on any restore. This is the version the branch is developed and run against.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rcrc3" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tvheadend.Htsp\Tvheadend.Htsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

</Project>
