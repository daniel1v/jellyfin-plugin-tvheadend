<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The C# compiler's own parser, for the two architecture rules that have to be read from
      source rather than from metadata. It is here and nowhere else: the plugin package carries
      only the three assemblies named in build.yaml, so none of this reaches a server.

      It replaced a hand-written lexer. That lexer read the string forms it had been shown and
      quietly mis-read the ones it had not, raw and verbatim interpolated strings among them,
      which is a rule that can be walked around by writing the violation an unusual way. Keeping
      a half-grammar of C# up to date is not this repository's job.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Named as well as reached through the plugin, because the core's own reasoning is tested
         directly rather than only through whatever happens to call it. -->
    <ProjectReference Include="..\TVHeadEnd.Core\TVHeadEnd.Core.csproj" />
    <ProjectReference Include="..\TVHeadEnd\TVHeadEnd.csproj" />

    <!--
      With its runtime assets, unlike the plugin. The plugin borrows the SkiaSharp that the server
      already loads, but a test process has no server, so it needs the native library itself.

      One native package per platform the tests run on, and both are needed: the assets are chosen
      by runtime identifier, so a Windows-only reference leaves nothing to load on Linux. That is
      what CI hit, with six SquareCanvasTests failing on ubuntu-latest for "Unable to load shared
      library 'libSkiaSharp'" on a build that had otherwise passed.

      NoDependencies is the Linux build that carries no fontconfig requirement. Nothing here draws
      text, and a native library that needs nothing installed on the runner is one fewer thing for
      a CI image to stop providing.

      These belong to this project alone. The plugin package carries only the two assemblies named
      in build.yaml, so none of this can reach it.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
