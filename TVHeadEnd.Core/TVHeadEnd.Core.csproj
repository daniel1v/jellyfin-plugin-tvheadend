<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TVHeadEnd.Core</RootNamespace>
    <AssemblyName>TVHeadEnd.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Description>What this plugin knows about broadcasts, recordings and transport streams, on its own. No Jellyfin, no TVHeadend protocol, no hosting -- the rule is enforced by there being nothing here to reference them with.</Description>
  </PropertyGroup>

  <!--
    Deliberately empty of ProjectReference and of any runtime package. Everything here is either
    the base class library or this plugin's own reasoning about a broadcast, and the absence of a
    reference is what makes that a fact rather than an intention: there is no way to reach a
    Jellyfin type, an HTSP message or an ASP.NET request from inside this assembly, so nothing in
    it can quietly grow a dependency on one.

    The analyzers are the exception, and they are build-time only.
  -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <!--
    The tests exercise this assembly's own reasoning directly, including the parts that are
    deliberately not part of its public surface. Widening that surface so a test can reach it
    would publish implementation detail to the whole plugin instead.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TVHeadEnd.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
